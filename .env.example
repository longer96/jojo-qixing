# ========== AI 接口配置（必填才能真实对话）==========
# 复制本文件为 .env.local 后填写，切勿把含真实密钥的文件提交到 Git。
# 本项目支持任意「OpenAI 兼容 Chat Completions」网关，更换模型只需改下面三个变量。

# 网关 API Key（必填；也可用 OPENAI_API_KEY 作为兜底变量名）
AI_API_KEY=

# OpenAI 兼容网关地址（也可用 OPENAI_BASE_URL 作为兜底变量名）
# 默认： https://token.xjjj.co/v1
# 示例： DeepSeek  https://api.deepseek.com/v1
# 示例： 豆包方舟  https://ark.cn-beijing.volces.com/api/v3
# 示例： OpenAI    https://api.openai.com/v1
AI_API_BASE_URL=https://token.xjjj.co/v1

# 默认模型（Qwen3.8-27B 若不稳定可改用下方推荐值）
# 换成其他网关的模型名即可，例如 deepseek-chat、doubao-pro-32k、gpt-4o-mini
AI_MODEL=Qwen3.8-27B-dflash2

# 可选：主模型失败时的回退模型链（逗号分隔，须为同一网关下存在的模型）
# 不填时：使用默认网关默认模型会自动回退 qwen3.8-flash -> Qwen3.8-27B；
# 一旦自定义了 AI_MODEL，默认不再回退。
# AI_FALLBACK_MODELS=qwen3.8-flash,Qwen3.8-27B

# 可选：知识库向量检索的 Embedding 模型（默认 text-embedding-3-small）
# 网关不支持 embeddings 接口时无需配置，检索会自动降级为关键词匹配
# AI_EMBEDDING_MODEL=text-embedding-3-small

# 可选：强制本地模拟回复（不调用真实接口）
# MOCK_AI=1
